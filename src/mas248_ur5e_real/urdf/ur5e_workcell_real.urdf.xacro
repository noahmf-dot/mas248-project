<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mas248_ur5e">

  
  <xacro:arg name="tool_tcp_port" default="54321" /><xacro:arg name="tool_device_name" default="/tmp/ttyUR" /><xacro:arg name="tool_tx_idle_chars" default="3.5" /><xacro:arg name="tool_rx_idle_chars" default="1.5" /><xacro:arg name="tool_stop_bits" default="1" /><xacro:arg name="tool_baud_rate" default="115200" /><xacro:arg name="tool_parity" default="0" /><xacro:arg name="tool_voltage" default="0" /><xacro:arg name="use_tool_communication" default="false" /><xacro:arg name="verify_robot_model" default="true" /><xacro:arg name="headless_mode" default="false" /><xacro:arg name="safety_k_position" default="20" /><xacro:arg name="safety_pos_margin" default="0.15" /><xacro:arg name="trajectory_port" default="50003" /><xacro:arg name="script_command_port" default="50004" /><xacro:arg name="script_sender_port" default="50002" /><xacro:arg name="reverse_port" default="50001" /><xacro:arg name="reverse_ip" default="0.0.0.0" /><xacro:arg name="output_recipe_filename" default="$(find ur_robot_driver)/resources/rtde_output_recipe.txt" /><xacro:arg name="input_recipe_filename" default="$(find ur_robot_driver)/resources/rtde_input_recipe.txt" /><xacro:arg name="script_filename" default="$(find ur_client_library)/resources/external_control.urscript" /><xacro:arg name="visual_params" default="$(find mas248_ur5e_real)/config/ur5e/visual_parameters.yaml" /><xacro:arg name="physical_params" default="$(find mas248_ur5e_real)/config/ur5e/physical_parameters.yaml" /><xacro:arg name="joint_limit_params" default="$(find mas248_ur5e_real)/config/ur5e/joint_limits.yaml" /><xacro:arg name="kinematics_params" default="" /><xacro:arg name="ur_type" default="ur5e" />
  <xacro:arg name="tf_prefix" default="" />
  <xacro:arg name="robot_ip" default="0.0.0.0" />
  <xacro:arg name="safety_limits" default="true" />
  <xacro:arg name="name" default="ur5e" />
  <xacro:arg name="use_fake_hardware" default="false" />

  
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro" /> 




  
  <link name="world" />  

  
  
 <link name="pedestal_link" />
  
  
  
   <link name="spindle">
    
    <visual>
      <origin xyz="0 0 0.035" />
      <geometry>
        <box size="0.040 0.030 0.070" />
      </geometry>
      <material name="holder_black">
        <color rgba="0.15 0.15 0.15 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.035" />
      <geometry>
        <box size="0.040 0.030 0.070" />
      </geometry>
    </collision>

    
    <visual>
      <origin xyz="0 -0.050 0.070" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.007" length="0.100" />
      </geometry>
      <material name="pen_green">
        <color rgba="0.1 0.65 0.2 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0 -0.050 0.070" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.007" length="0.100" />
      </geometry>
    </collision>
  </link>
  

  
  <link name="tcp" />

  
  <joint name="tool0_to_spindle" type="fixed">
    <parent link="tool0" />
    <child link="spindle" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

   
  <joint name="spindle_to_tcp" type="fixed">
    <parent link="spindle" />
    <child link="tcp" />
    <origin xyz="0 -0.100 0.070" rpy="1.57079632679 0 0" />
  </joint>

  
  <joint name="world_to_pedestal" type="fixed">
    <parent link="world" />
    <child link="pedestal_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>



  
  <xacro:ur_robot name="$(arg name)" ur_type="$(arg ur_type)" tf_prefix="$(arg tf_prefix)" parent="pedestal_link" joint_limits_parameters_file="$(arg joint_limit_params)" kinematics_parameters_file="$(arg kinematics_params)" physical_parameters_file="$(arg physical_params)" visual_parameters_file="$(arg visual_params)" safety_limits="$(arg safety_limits)" safety_pos_margin="$(arg safety_pos_margin)" safety_k_position="$(arg safety_k_position)" generate_ros2_control_tag="true" use_fake_hardware="false" headless_mode="$(arg headless_mode)" robot_ip="$(arg robot_ip)" script_filename="$(arg script_filename)" input_recipe_filename="$(arg input_recipe_filename)" output_recipe_filename="$(arg output_recipe_filename)" reverse_ip="$(arg reverse_ip)" reverse_port="$(arg reverse_port)" script_sender_port="$(arg script_sender_port)" script_command_port="$(arg script_command_port)" trajectory_port="$(arg trajectory_port)" verify_robot_model="$(arg verify_robot_model)" use_tool_communication="$(arg use_tool_communication)" tool_voltage="$(arg tool_voltage)" tool_parity="$(arg tool_parity)" tool_baud_rate="$(arg tool_baud_rate)" tool_stop_bits="$(arg tool_stop_bits)" tool_rx_idle_chars="$(arg tool_rx_idle_chars)" tool_tx_idle_chars="$(arg tool_tx_idle_chars)" tool_device_name="$(arg tool_device_name)" tool_tcp_port="$(arg tool_tcp_port)" fake_sensor_commands="false" sim_gazebo="false" sim_ignition="false">
  <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:ur_robot>

  
    
  <link name="table_link">
    <visual>
      <geometry>
        <box size="1.60 1.00 0.040" />
      </geometry>
      <material name="table_grey">
        <color rgba="0.65 0.65 0.68 1" />
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="1.60 1.00 0.040" />
      </geometry>
    </collision>
  </link>

  <joint name="base_to_table" type="fixed">
    <parent link="base" />
    <child link="table_link" />
    <origin xyz="0.400 0.345 -0.3225" rpy="0 0 0" />
  </joint>

  
  <link name="paper_link">
    <visual>
      <geometry>
        <box size="0.297 0.420 0.0002" />
      </geometry>
      <material name="paper_white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
  </link>

  <joint name="base_to_paper" type="fixed">
    <parent link="base" />
    <child link="paper_link" />
    <origin xyz="0.4885 0.065 -0.3005" rpy="0 0 0" />
  </joint>

</robot>